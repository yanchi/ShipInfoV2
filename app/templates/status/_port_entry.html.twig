{#
    便の1件分（港別・トップ・会社別で共通）。1段目に出港時刻とステータス、2段目に補足（FR-005・research R14）

    引数:
      entry:           App\View\PortBoardEntry
      day:             その行の日付（着時刻の表示に使う）
      now:             現在時刻（出港済みの判定。null なら判定しない）
      commonCheckedAt: 方向の見出しに出している確認時刻（null 可）
#}
{%- set now = now|default(null) -%}
{%- set departed = now is not null and entry.isDeparted(now) -%}
{%- set classes = ['port-entry', 'mt-1'] -%}
{%- if entry.isAlert -%}
    {%- set classes = classes|merge(['port-entry--alert', 'port-entry--' ~ entry.status.value]) -%}
{%- endif -%}
{%- if departed -%}
    {%- set classes = classes|merge(['port-entry--departed']) -%}
{%- endif -%}
<div class="{{ classes|join(' ') }}">
    <div class="d-flex flex-wrap align-items-center gap-2">
        {% if entry.departureAt %}
            <span class="fw-bold">{{ entry.departureAt|date('H:i') }}発</span>
        {% endif %}
        <span class="{{ entry.isAlert ? 'fw-bold' }}">{{ include('status/_status_badge.html.twig', {state: entry.state.value == 'status' ? null : entry.state, status: entry.status}) }}</span>
        {% if departed %}
            <span class="small text-muted">出港済み</span>
        {% endif %}
    </div>
    {%- set showCheckedAt = entry.checkedAtDiffersFrom(commonCheckedAt|default(null)) -%}
    {% if entry.shipName or entry.companyName or entry.arrivalAt or showCheckedAt %}
        <div class="small text-muted d-flex flex-wrap column-gap-2">
            {% if entry.shipName or entry.companyName %}
                <span>{{ entry.shipName ? entry.shipName ~ '／' : '' }}{{ entry.companyName }}</span>
            {% endif %}
            {% if entry.arrivalAt %}
                <span>{{ entry.arrivalText(day) }}</span>
            {% endif %}
            {% if showCheckedAt %}
                <span class="ms-auto">{{ entry.checkedAt|date('n/j H:i') }}時点</span>
            {% endif %}
        </div>
    {% endif %}
    {% if entry.detail %}
        {% if entry.detail|length > 60 %}
            <details class="small text-muted mt-1">
                {#- 開いたら summary の続き（61文字目以降）だけを出して、先頭が2回出ないようにする -#}
                <summary>{{ entry.detail|slice(0, 60) }}…</summary>
                …{{ entry.detail|slice(60) }}
            </details>
        {% else %}
            <div class="small text-muted mt-1">└ {{ entry.detail }}</div>
        {% endif %}
    {% endif %}
</div>

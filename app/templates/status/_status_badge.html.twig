{#
    ステータスバッジ（トップ・会社詳細・港別の3画面で共通。specs/5-ui-readability/contracts/ui-status.md）

    引数:
      state:  App\Enum\DepartureDisplayStateEnum|null
              null のときは status だけで判定する（トップ・会社詳細の呼び方）
      status: App\Enum\OperationStatusEnum|null
              state が null で status も null → 「情報なし」
#}
{%- set state = state|default(null) -%}
{%- set status = status|default(null) -%}
{%- if state is not null and state.value == 'scheduled' -%}
    <span class="status-badge status-badge--scheduled">○ 運航予定</span>
{%- elseif state is not null and state.value == 'no_info' -%}
    <span class="status-badge status-badge--muted">？ 情報なし</span>
{%- elseif (state is not null and state.value == 'no_service') or (status is not null and status.value == 'no_service') -%}
    <span class="status-none text-secondary">— 便なし</span>
{%- elseif status is null -%}
    <span class="status-badge status-badge--muted">？ 情報なし</span>
{%- elseif status.value == 'operating' -%}
    <span class="status-badge status-badge--operating">✓ {{ status.label() }}</span>
{%- elseif status.value == 'delayed' -%}
    <span class="status-badge status-badge--delayed">▲ {{ status.label() }}</span>
{%- elseif status.value == 'cancelled' -%}
    <span class="status-badge status-badge--cancelled">✗ {{ status.label() }}</span>
{%- elseif status.value == 'suspended' -%}
    <span class="status-badge status-badge--suspended">■ {{ status.label() }}</span>
{%- elseif status.value == 'unknown' -%}
    <span class="status-badge status-badge--muted">？ {{ status.label() }}</span>
{%- else -%}
    <span class="status-badge status-badge--muted">？ 情報なし</span>
{%- endif -%}

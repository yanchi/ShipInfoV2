{% extends 'base.html.twig' %}

{% block title %}港別運航情報 | ShipInfo{% endblock %}

{% block body %}
<div class="container py-4">
    <a href="{{ path('app_status_index') }}" class="text-muted text-decoration-none small">← トップへ戻る</a>

    <h1 class="h4 mt-2 mb-2">港別運航情報</h1>

    {% if not fullBoard.isEmpty %}
        <nav class="date-nav d-flex gap-1 py-2 mb-2" aria-label="日付">
            {% for day in board.days %}
                <a href="#d-{{ day.date|date('Y-m-d') }}" class="btn btn-sm btn-outline-secondary flex-fill">{{ day.date|date('n/j') }}（{{ ['日','月','火','水','木','金','土'][day.date|date('w')] }}）</a>
            {% endfor %}
        </nav>
    {% endif %}

    <form method="get" action="{{ path('app_status_ports') }}" class="port-filter mb-2">
        <select name="port" class="form-select form-select-sm" aria-label="出発港">
            <option value="all">全港</option>
            {% for port in portOptions %}
                <option value="{{ port.id }}"{{ filter.portId == port.id ? ' selected' }}>{{ port.name }}</option>
            {% endfor %}
        </select>
        <select name="dir" class="form-select form-select-sm" aria-label="方向">
            <option value="">両方向</option>
            <option value="down"{{ filter.direction and filter.direction.value == 'down' ? ' selected' }}>下り</option>
            <option value="up"{{ filter.direction and filter.direction.value == 'up' ? ' selected' }}>上り</option>
        </select>
        <button type="submit" class="btn btn-sm btn-primary">表示</button>
        <button type="submit" name="save" value="1" class="btn btn-sm btn-outline-primary">この港を保存</button>
    </form>

    {% if filter.isActive or filter.hasSaved %}
        <div class="filter-status small mb-3">
            {% if filter.isActive %}
                {%- set labels = [] -%}
                {%- for port in portOptions|filter(p => p.id == filter.portId) -%}
                    {%- set labels = labels|merge([port.name ~ '発']) -%}
                {%- endfor -%}
                {%- if filter.direction -%}
                    {%- set labels = labels|merge([filter.direction.value == 'down' ? '下り' : '上り']) -%}
                {%- endif -%}
                <span class="me-2">{{ labels|join('・') }}のみ表示中</span>
                <a href="{{ path('app_status_ports', {port: 'all'}) }}" class="me-2">全港に戻す</a>
            {% endif %}
            {% if filter.hasSaved %}
                <a href="{{ path('app_status_ports', {clear: 1}) }}" class="text-secondary">保存を解除</a>
            {% endif %}
        </div>
    {% endif %}

    {{ include('status/_alert_summary.html.twig', {summary: summary, linkPrefix: ''}) }}

    {{ include('status/_status_legend.html.twig') }}

    {% if fullBoard.isEmpty %}
        <div class="alert alert-secondary">港別の情報がありません。</div>
    {% else %}
        {% for day in board.days %}
            <section class="mb-4" id="d-{{ day.date|date('Y-m-d') }}">
                <h2 class="h5 border-bottom pb-1 mb-3">
                    {{ day.date|date('n月j日（') }}{{ ['日','月','火','水','木','金','土'][day.date|date('w')] }}）
                </h2>
                {% if day.directions is empty %}
                    <p class="text-muted small">条件に合う便はありません。</p>
                {% endif %}
                {% for direction in day.directions %}
                    {%- set commonCheckedAt = direction.commonCheckedAt -%}
                    <h3 class="h6 text-muted mt-3 mb-2 d-flex flex-wrap column-gap-2">
                        <span>{{ direction.direction.label }}</span>
                        {% if commonCheckedAt %}
                            <span class="checked-at small fw-normal ms-auto">{{ commonCheckedAt|date('n/j H:i') }}時点</span>
                        {% endif %}
                    </h3>
                    <div class="card mb-3">
                        <ul class="list-group list-group-flush">
                            {% for row in direction.rows %}
                                <li class="list-group-item port-row" id="r-{{ day.date|date('Y-m-d') }}-{{ direction.direction.value }}-{{ row.port.id }}">
                                    <div class="fw-bold">{{ row.port.name }}発 → {{ direction.arrivalPortName }}</div>
                                    {% for entry in row.entries %}
                                        {{ include('status/_port_entry.html.twig', {entry: entry, day: day.date, now: now, commonCheckedAt: commonCheckedAt}) }}
                                    {% endfor %}
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endfor %}
            </section>
        {% endfor %}
    {% endif %}

    <footer class="text-muted small mt-4">
        運航情報はスクレイピングにより収集しています。最新情報は各社公式サイトをご確認ください。
    </footer>
</div>
{% endblock %}

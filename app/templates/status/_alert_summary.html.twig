{#
    異常の要約（港別・トップで共通。FR-009〜013）

    引数:
      summary:    App\View\PortAlertSummary
      linkPrefix: 行へのリンクの前に付ける URL（港別ページは ''、トップは '/ports?port=all'）
#}
{%- macro item(alert, linkPrefix) -%}
    <a href="{{ linkPrefix }}#{{ alert.anchor }}" class="alert-item d-flex align-items-center gap-1 text-reset text-decoration-none py-1">
        <span class="text-nowrap">{{ alert.date|date('n/j') }}（{{ ['日','月','火','水','木','金','土'][alert.date|date('w')] }}）</span>
        <span class="fw-bold text-nowrap">{{ alert.port.name }}発→{{ alert.arrivalPortName }}</span>
        {{ include('status/_status_badge.html.twig', {state: null, status: alert.entry.status}) }}
        {% if alert.entry.companyName %}<span class="small text-muted text-truncate">{{ alert.entry.companyName }}</span>{% endif %}
    </a>
{%- endmacro -%}
{%- if summary.hasData -%}
<div class="alert-summary border rounded px-3 py-2 mb-3">
    {% if summary.alerts is not empty %}
        <div class="fw-bold small mb-1">欠航・条件付などの便</div>
        {% for alert in summary.alerts|slice(0, 3) %}
            {{ _self.item(alert, linkPrefix) }}
        {% endfor %}
        {% if summary.alerts|length > 3 %}
            <details>
                <summary class="small">ほか {{ summary.alerts|length - 3 }} 件</summary>
                {% for alert in summary.alerts|slice(3) %}
                    {{ _self.item(alert, linkPrefix) }}
                {% endfor %}
            </details>
        {% endif %}
    {% elseif summary.hiddenCount == 0 %}
        <div class="small text-muted">表示期間内に欠航・条件付の便はありません</div>
    {% endif %}
    {% if summary.hiddenCount > 0 %}
        <div class="small mt-1">
            他の港にも欠航・条件付などがあります（{{ summary.hiddenCount }}件）
            <a href="{{ path('app_status_ports', {port: 'all'}) }}">全港を見る</a>
        </div>
    {% endif %}
</div>
{%- endif -%}

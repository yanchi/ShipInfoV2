<!DOCTYPE html>
<html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}ShipInfo - フェリー運航情報{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <style>
            /* 共通の CSS（アセットのビルド環境は入れないので、ここに置く） */

            /* ステータス表示（specs/5-ui-readability/contracts/ui-status.md） */
            .badge-scheduled { background: var(--bs-body-bg); color: var(--bs-body-color); border: 1px dashed var(--bs-secondary); }
            .badge-muted { background: var(--bs-secondary-bg-subtle); color: var(--bs-secondary-text-emphasis); }

            /* 異常の行（FR-014）：左の太い線・薄い背景・太字 */
            .port-entry--alert { border-left: 4px solid; padding: .25rem .5rem; }
            .port-entry--alert .badge { font-weight: 800; }
            .port-entry--cancelled { border-left-color: var(--bs-danger); background: var(--bs-danger-bg-subtle); }
            .port-entry--delayed { border-left-color: var(--bs-warning); background: var(--bs-warning-bg-subtle); }
            .port-entry--suspended { border-left-color: var(--bs-secondary); background: var(--bs-secondary-bg-subtle); }

            /* 異常の要約。1項目1行に収め、会社名は省略して詰める */
            .alert-item { font-size: .875rem; min-width: 0; }

            /* 出港済みの行（FR-008） */
            .port-entry--departed { opacity: .55; }

            /* 日付ボタン（FR-007）。スクロールしても上に残し、飛んだ先の見出しが隠れないようにする */
            .date-nav { position: sticky; top: 0; z-index: 10; background: var(--bs-body-bg); }
            .date-nav .btn { white-space: nowrap; padding-left: .25rem; padding-right: .25rem; }
            section[id^="d-"], li[id^="r-"] { scroll-margin-top: 3.25rem; }

            /* 絞り込みフォーム。375px でも1行に収める */
            .port-filter { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto auto; gap: .25rem; align-items: center; }
            .port-filter .form-select { padding-left: .5rem; }
        </style>
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        {% block body %}{% endblock %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>

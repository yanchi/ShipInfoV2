<!DOCTYPE html>
<html lang="ja" data-bs-theme="light">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {#- canonical・og:url はクエリ無しの URL（全ページ同じ式）。og:image も同じスキーム＋ホスト。title・description は og でも同じ値を使う -#}
        {%- set canonical_url = app.request.schemeAndHttpHost ~ app.request.pathInfo -%}
        <title>{% block full_title %}{% block title %}{% endblock %}{{ title_suffix }}{% endblock %}</title>
        <meta name="description" content="{% block description %}鹿児島〜沖縄・奄美大島を結ぶAライン・マリックスラインのリアルタイム運航状況。欠航・遅延・通常運航を毎時更新でお知らせします。{% endblock %}">
        <link rel="canonical" href="{{ canonical_url }}">
        <meta property="og:title" content="{{ block('full_title')|trim|raw }}">
        <meta property="og:description" content="{{ block('description')|trim|raw }}">
        <meta property="og:url" content="{{ canonical_url }}">
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="{{ og_site_name }}">
        <meta property="og:image" content="{{ app.request.schemeAndHttpHost }}/og-image.png">
        <meta property="og:image:type" content="image/png">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:image:alt" content="{{ og_image_alt }}">
        <meta name="twitter:card" content="summary_large_image">
        <link rel="icon" type="image/svg+xml" href="/favicon.svg">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        {{ include('_site_styles.html.twig') }}
        {% block stylesheets %}{% endblock %}
        {% if app.environment == 'prod' and ga_measurement_id %}
        <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id={{ ga_measurement_id|e('url') }}"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '{{ ga_measurement_id|e('js') }}');
        </script>
        {% endif %}
    </head>
    <body>
        {#- 共通ヘッダー（FR-022）。JS 無しでも使えるよう、折りたたまず1行にし、「各社」は <details> で開く -#}
        {%- set currentRoute = app.request.attributes.get('_route') -%}
        {%- set currentCompanyId = currentRoute == 'app_status_company' ? app.request.attributes.get('id')|default(null) : null -%}
        <header class="site-header">
            {#- サイト名はナビの外に置く（ナビの中の「トップ」と a[href="/"] が二重にならないように）。h1 にはしない -#}
            <a class="site-name" href="{{ path('app_status_index') }}">{% for part in site_name|split(' ') %}<span>{{ part }}</span>{% if not loop.last %} {% endif %}{% endfor %}</a>
            <nav class="site-nav" aria-label="サイト">
                <a href="{{ path('app_status_index') }}" class="{{ currentRoute == 'app_status_index' ? 'active' }}"{% if currentRoute == 'app_status_index' %} aria-current="page"{% endif %}>トップ</a>
                <a href="{{ path('app_status_ports') }}" class="{{ currentRoute == 'app_status_ports' ? 'active' }}"{% if currentRoute == 'app_status_ports' %} aria-current="page"{% endif %}>港別</a>
                {% block site_companies_menu %}
                <details class="site-companies">
                    <summary class="{{ currentRoute == 'app_status_company' ? 'active' }}">各社</summary>
                    <ul class="site-companies-menu list-unstyled rounded shadow-sm py-1 mb-0">
                        {% for company in site_companies() %}
                            {%- set isCurrent = currentCompanyId is not null and currentCompanyId == company.id -%}
                            <li><a href="{{ path('app_status_company', {id: company.id}) }}" class="dropdown-item{{ isCurrent ? ' active' }}"{% if isCurrent %} aria-current="page"{% endif %}>{{ company.name }}</a></li>
                        {% endfor %}
                    </ul>
                </details>
                {% endblock %}
            </nav>
        </header>

        {#- 最終確認時刻と古い情報の警告（FR-023） -#}
        {% block site_freshness %}
        {%- set freshness = site_freshness() -%}
        {% if freshness.isStale %}
            <div class="container mt-2">
                <div class="site-freshness alert alert-warning py-2 small mb-0" role="alert">
                    情報が古い可能性があります（{{ freshness.staleCompanies|join('、') }} の情報が{{ freshness.staleHours }}時間以上更新されていません）
                    {%- if freshness.checkedAt %}。最終確認 {{ freshness.checkedAt|date('n/j H:i') }}{% endif %}
                </div>
            </div>
        {% elseif freshness.checkedAt %}
            <div class="container">
                <p class="site-freshness small text-muted text-end mt-1 mb-0">最終確認 {{ freshness.checkedAt|date('n/j H:i') }}</p>
            </div>
        {% endif %}
        {% endblock %}

        {% block body %}{% endblock %}
        <footer class="site-footer"><p class="mb-0">{{ copyright }}</p></footer>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>

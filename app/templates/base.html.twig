<!DOCTYPE html>
<html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}ShipInfo - フェリー運航情報{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <style>
            /* 共通の CSS（アセットのビルド環境は入れないので、ここに置く） */

            /* 共通ヘッダー（FR-022）。「各社」は <details> のドロップダウン */
            .site-header .nav-link.active, .site-header summary.active { color: var(--bs-emphasis-color); }
            .site-companies { position: relative; }
            .site-companies > summary { cursor: pointer; list-style: none; color: var(--bs-link-color); }
            .site-companies > summary::-webkit-details-marker { display: none; }
            .site-companies > summary::after { content: " ▾"; }
            .site-companies-menu { position: absolute; top: 100%; left: 0; z-index: 20; min-width: 12rem; margin-top: .25rem; background: var(--bs-body-bg); }

            /* ステータス表示（specs/5-ui-readability/contracts/ui-status.md） */
            .badge-scheduled { background: var(--bs-body-bg); color: var(--bs-body-color); border: 1px dashed var(--bs-secondary); }
            .badge-muted { background: var(--bs-secondary-bg-subtle); color: var(--bs-secondary-text-emphasis); }

            /* 異常の行（FR-014）：左の太い線・薄い背景・太字 */
            .port-entry--alert { border-left: 4px solid; padding: .25rem .5rem; }
            .port-entry--alert .badge { font-weight: 800; }
            .port-entry--cancelled { border-left-color: var(--bs-danger); background: var(--bs-danger-bg-subtle); }
            .port-entry--delayed { border-left-color: var(--bs-warning); background: var(--bs-warning-bg-subtle); }
            .port-entry--suspended { border-left-color: var(--bs-secondary); background: var(--bs-secondary-bg-subtle); }

            /* 異常の要約。1項目1行に収め、会社名は省略して詰める */
            .alert-item { font-size: .875rem; min-width: 0; }

            /* 出港済みの行（FR-008） */
            .port-entry--departed { opacity: .55; }

            /* 日付ボタン（FR-007）。スクロールしても上に残し、飛んだ先の見出しが隠れないようにする */
            .date-nav { position: sticky; top: 0; z-index: 10; background: var(--bs-body-bg); }
            .date-nav .btn { white-space: nowrap; padding-left: .25rem; padding-right: .25rem; }
            section[id^="d-"], li[id^="r-"] { scroll-margin-top: 3.25rem; }

            /* 絞り込みフォーム。375px でも1行に収める */
            .port-filter { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto auto; gap: .25rem; align-items: center; }
            .port-filter .form-select { padding-left: .5rem; }
        </style>
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        {#- 共通ヘッダー（FR-022）。JS 無しでも使えるよう、折りたたまず1行にし、「各社」は <details> で開く -#}
        {%- set currentRoute = app.request.attributes.get('_route') -%}
        {%- set currentCompanyId = currentRoute == 'app_status_company' ? app.request.attributes.get('id')|default(null) : null -%}
        <header class="site-header border-bottom">
            <nav class="container d-flex align-items-center gap-3 py-2" aria-label="サイト">
                <a href="{{ path('app_status_index') }}" class="site-brand fw-bold text-decoration-none text-reset{{ currentRoute == 'app_status_index' ? ' active' }}"{% if currentRoute == 'app_status_index' %} aria-current="page"{% endif %}>ShipInfo</a>
                <a href="{{ path('app_status_ports') }}" class="nav-link p-0{{ currentRoute == 'app_status_ports' ? ' active fw-bold' }}"{% if currentRoute == 'app_status_ports' %} aria-current="page"{% endif %}>港別</a>
                <details class="site-companies">
                    <summary class="nav-link p-0{{ currentRoute == 'app_status_company' ? ' active fw-bold' }}">各社</summary>
                    <ul class="site-companies-menu list-unstyled border rounded shadow-sm py-1 mb-0">
                        {% for company in site_companies() %}
                            {%- set isCurrent = currentCompanyId is not null and currentCompanyId == company.id -%}
                            <li><a href="{{ path('app_status_company', {id: company.id}) }}" class="dropdown-item{{ isCurrent ? ' active' }}"{% if isCurrent %} aria-current="page"{% endif %}>{{ company.name }}</a></li>
                        {% endfor %}
                    </ul>
                </details>
            </nav>
        </header>

        {#- 最終確認時刻と古い情報の警告（FR-023） -#}
        {%- set freshness = site_freshness() -%}
        {% if freshness.isStale %}
            <div class="container mt-2">
                <div class="site-freshness alert alert-warning py-2 small mb-0" role="alert">
                    情報が古い可能性があります（{{ freshness.staleCompanies|join('、') }} の情報が{{ freshness.staleHours }}時間以上更新されていません）
                    {%- if freshness.checkedAt %}。最終確認 {{ freshness.checkedAt|date('n/j H:i') }}{% endif %}
                </div>
            </div>
        {% elseif freshness.checkedAt %}
            <div class="container">
                <p class="site-freshness small text-muted text-end mt-1 mb-0">最終確認 {{ freshness.checkedAt|date('n/j H:i') }}</p>
            </div>
        {% endif %}

        {% block body %}{% endblock %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>

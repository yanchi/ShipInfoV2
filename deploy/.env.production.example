# VPS の /opt/shipinfo-v2/.env.production に置く（git には入れない）。
# chmod 600 にすること。

# CI がデプロイのたびに SHA タグで上書きする（手で起動するときだけ使う）
# APP_IMAGE=ghcr.io/yanchi/shipinfov2/app:latest
# SCRAPER_IMAGE=ghcr.io/yanchi/shipinfov2/scraper:latest

# ホストの nginx（deploy/nginx/shipinfo-v2.conf）の proxy_pass と揃える
APP_PORT=8002

# openssl rand -hex 32
APP_SECRET=
# コマンドから URL を作るときの基準（https://ドメイン）
DEFAULT_URI=https://v2.ship.isl-mentor.com

# Google アナリティクスの測定 ID。V1 と並べている間は空のまま。切り替えのときに V1 と同じ ID を入れる
GOOGLE_ANALYTICS_ID=

# 運航に変更がある便の通知メール（1・6・15 時）。空なら送らずに警告だけ出す
# ユーザー名・パスワードに記号があれば URL エンコードする（@ → %40、: → %3A、/ → %2F など）
# 例 MAILER_DSN=smtp://USER:PASSWORD@smtp.example.com:587
MAILER_DSN=
NOTIFY_FROM=
# カンマ区切りで複数
NOTIFY_TO=

DB_NAME=shipinfo
DB_USER=shipinfo
# openssl rand -hex 16
DB_PASSWORD=
DB_ROOT_PASSWORD=

SCRAPER_INTERVAL_MINUTES=30
LOG_LEVEL=INFO
